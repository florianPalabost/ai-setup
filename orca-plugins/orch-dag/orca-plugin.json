{
  "manifestVersion": 2,
  "id": "orch-dag",
  "name": "Orchestration Graph",
  "version": "0.1.0",
  "description": "Read-only graph of an orchestration run's tasks.",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "worker/main.mjs",
  "contributes": {
    "panels": [
      {
        "id": "graph",
        "title": "Run graph",
        "icon": "agent",
        "entry": "panel/index.html",
        "ui": "html"
      }
    ],
    "customEditors": [
      {
        "id": "graph-editor",
        "title": "Run graph",
        "extensions": [
          ".orcagraph"
        ],
        "entry": "panel/index.html",
        "frame": "isolated"
      }
    ],
    "newFiles": [
      {
        "id": "run-graph",
        "title": "Orchestration run graph",
        "extension": ".orcagraph",
        "template": "templates/new.orcagraph"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "workspace:read"
    },
    {
      "kind": "agent:read"
    },
    {
      "kind": "workspace:write"
    }
  ],
  "icon": "icon.png"
}
