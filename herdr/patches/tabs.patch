+
+// The side panels this setup adds, in button order. Each button shows when the
+// layout has that panel's block.
+const PANELS = [
+  { id: "find", label: "Find", icon: "mods/workspace-chrome/search.svg" },
+  { id: "factory", label: "Factory", icon: "mods/workspace-chrome/layers.svg" },
+  { id: "changes", label: "Git", icon: "mods/workspace-chrome/git-branch.svg" },
+  { id: "automations", label: "Automations", icon: "mods/automations/automations.svg" },
+];
+// A key bound to "tabs-git.show-<panel id>" opens that panel.
+const SHOW_COMMAND = "show-";
+// The Automations button counts the finished runs no one has opened yet.
+const AUTOMATIONS = "herdr-automations";
+const FINISHED = new Set(["done", "failed", "cancelled"]);
+// How often to look again for a CLI that wasn't there, as install.sh can add it to an open window.
+const AUTOMATIONS_RETRY_MS = 30000;
+
+function showPanel(id) {
+  run("layout.select", { stack: "panel-body", child: id });
+  run("layout.show", { id: "panel" });
+}
