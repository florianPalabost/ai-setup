+  async watchAutomations(cx) {
+    this.watchingAutomations = true;
+    try {
+      const cli = await automationsCli();
+      const json = async (args) => {
+        const r = await exec(cli, args);
+        if (r.code !== 0) throw new Error(r.stderr);
+        return JSON.parse(r.stdout);
+      };
+      const countUnread = async () => {
+        const runs = await json(["history", "--json"]);
+        this.unread = runs.filter(r => FINISHED_RUN.has(r.status) && !r.seen).length;
+        cx.notify();
+      };
+      const historyDir = (await json(["ls", "--json"])).state;
+      if (!historyDir) return;
+      await countUnread();
+      for (;;) {
+        await watchFolder(historyDir);
+        await countUnread();
+      }
+    } catch {
+    } finally {
+      this.watchingAutomations = false;
+    }
+  }
+
