+  // Where the Automations panel finds the CLI: on PATH, else where its installer puts it.
+  async automationsBin() {
+    try { if ((await exec(AUTOMATIONS, ["version"])).code === 0) return AUTOMATIONS; } catch {}
+    return /^[A-Za-z]:[\\/]/.test(home()) ? `${home()}\\AppData\\Local\\Programs\\${AUTOMATIONS}\\${AUTOMATIONS}.exe`
+      : `${home()}/.local/bin/${AUTOMATIONS}`;
+  }
+
+  // Count the unread runs now, then again each time the history folder changes.
+  // Without the CLI there is no count and nothing to watch, until a retry finds it.
+  async watchAutomations(cx) {
+    if (this.watching) return;
+    const bin = await this.automationsBin();
+    const json = async (args) => {
+      const r = await exec(bin, args);
+      if (r.code !== 0) throw new Error(r.stderr);
+      return JSON.parse(r.stdout);
+    };
+    const count = async () => {
+      try {
+        const runs = await json(["history", "--json"]);
+        this.unread = runs.filter(r => FINISHED.has(r.status) && !r.seen).length;
+      } catch { this.unread = 0; }
+      cx.notify();
+    };
+    let state;
+    try { state = (await json(["ls", "--json"])).state; } catch { return; }
+    if (!state || this.watching) return;
+    this.watching = true;
+    await count();
+    for (;;) {
+      try { await watchFolder(state); } catch { return; }
+      await count();
+    }
+  }
+
