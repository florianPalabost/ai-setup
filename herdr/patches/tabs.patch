+];
+const SHOW_PANEL_PREFIX = "show-";
+const AUTOMATIONS_CLI = "herdr-automations";
+const FINISHED_RUN = new Set(["done", "failed", "cancelled"]);
+const RETRY_UNTIL_CLI_INSTALLED_MS = 30000;
+
+async function automationsCli() {
+  try { if ((await exec(AUTOMATIONS_CLI, ["version"])).code === 0) return AUTOMATIONS_CLI; } catch {}
+  return `${home()}/.local/bin/${AUTOMATIONS_CLI}`;
+}
+
+function showPanel(id) {
+  run("layout.select", { stack: "panel-body", child: id });
+  run("layout.show", { id: "panel" });
+}
