{
  "blocks": {
    "tabs": { "from": "tabs", "to": "tabs-git" },
    "spaces": { "from": "spaces", "to": "spaces-git" },
    "main": { "from": "pane", "to": "pane-git", "pane_header": true },
    "files": { "from": "files", "to": "files-git" },
    "changes": { "from": "changes", "to": "git", "feature": "git" }
  },
  "add": {
    "panel-body": [
      { "feature": "find", "id": "find", "type": "block", "content": { "mod": "find" } },
      { "feature": "factory", "id": "factory", "type": "block", "content": { "mod": "factory-board", "props": { "panel": true } } },
      { "feature": "automations", "id": "automations", "type": "block", "content": { "mod": "automations" } }
    ]
  },
  "wrap": {
    "main": {
      "feature": "bottom", "id": "main-column", "type": "column", "gap": 8,
      "after": [
        {
          "id": "bottom", "type": "stack", "header": { "content": "tabs", "height": 30 }, "active": "output",
          "size": { "px": 240 }, "min": 120, "hidden": true,
          "children": [{ "id": "output", "type": "block", "content": { "mod": "bottom-output" } }]
        }
      ]
    },
    "status": {
      "feature": "usage", "id": "status-row", "type": "row",
      "after": [{ "id": "usage", "type": "block", "content": { "mod": "claude-usage" }, "size": { "px": 290 } }]
    }
  }
}
