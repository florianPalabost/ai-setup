{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "tui": "fullscreen",
  "permissions": {
    "allow": [
      "Bash(php artisan route:list:*)",
      "Bash(composer show:*)",
      "Bash(npm ls:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./.env.staging)",
      "Read(./.env.testing)",
      "Read(./.env.backup)",
      "Read(~/.claude/.credentials.json)"
    ]
  }
}
